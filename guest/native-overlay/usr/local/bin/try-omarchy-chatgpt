#!/bin/bash
# OpenAI's ChatGPT desktop app on the zoo. The image cannot ship the app (it
# is proprietary), so `openzoo chatgpt` fetches the official Linux build for
# this guest's CPU on first run and unpacks it under ~/.openzoo/apps/chatgpt
# (no dpkg here), then launches it with its Codex side pointed at the local
# x402 proxy. No flags needed: run `try-omarchy-chatgpt` and wait.
# Pick "sign in with API key" in the app; any key works, the zoo takes
# payment, not keys.
#
# --deb <file|URL> overrides the download with your own copy (from
# https://chatgpt.com/download). Every other flag is passed to
# `openzoo chatgpt`.
set -euo pipefail

if ! command -v openzoo >/dev/null 2>&1; then
  cat >&2 <<'EOF'
openzoo is not installed yet. The first online boot installs it
(try-omarchy-openzoo-bootstrap.service); check with:
  systemctl status try-omarchy-openzoo-bootstrap
EOF
  exit 1
fi

args=()
while (($#)); do
  case "$1" in
    --deb)
      src=${2:-}
      [[ -n $src ]] || { echo "--deb needs a file or URL" >&2; exit 2; }
      shift 2
      if [[ $src == http://* || $src == https://* ]]; then
        mkdir -p "$HOME/Downloads"
        file="$HOME/Downloads/$(basename "${src%%\?*}")"
        curl -fL --progress-bar -o "$file" "$src"
        src=$file
      fi
      args+=(--deb "$src")
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

exec openzoo chatgpt "${args[@]}"
